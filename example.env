# Set these as secure environment variables; never commit real secrets.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini
GAPGPT_TIMEOUT_SECONDS=12
PORT=3000
# Optional: second semantic check uses an extra GapGPT call per answer.
GAPGPT_REVIEW_ENABLED=1

# Optional: controls for quality, extra GapGPT calls and deterministic SQL presentation
GAPGPT_STRICT_REVIEW=1
RESULT_NORMALIZATION_ENABLED=1

# v5.3: source-grounded Context Engineering; alternatives: focused, full.
# Changing this requires a new live evaluation (config fingerprint changes).
GAPGPT_CONTEXT_MODE=focused
